# GoldyXrogers — scraper de signaux (assistant scalping NY). Placeholders only.
# Copier en `.env` puis renseigner. Ne jamais committer le vrai `.env`.

# Bot Telegram — obtenu via @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Chat ID Telegram — obtenu via @userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Twelve Data (prix marché) ─────────────────────────────────────────────────
# Gratuit sur https://twelvedata.com — nécessaire pour bougies/FVG/DXY.
# Laisser vide pour désactiver les analyses marché.
TWELVEDATA_API_KEY=your_twelvedata_key_here

# ─── Nextcloud (historique & rapports, optionnel) ─────────────────────────────
NEXTCLOUD_URL=https://cloud.exemple.fr
NEXTCLOUD_USERNAME=your_user
NEXTCLOUD_PASSWORD=your_password_or_app_token
NEXTCLOUD_FOLDER=GoldyXrogers

# ─── Interne ───────────────────────────────────────────────────────────────────
TZ=UTC
