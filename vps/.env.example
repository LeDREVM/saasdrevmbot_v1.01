# ============================================================
# VPS Hostinger — Variables d'environnement
# Copier en .env et remplir les valeurs
# ============================================================

# --- VPS ---
VPS_IP=123.456.789.0          # IP publique de ton VPS Hostinger

# --- n8n ---
N8N_HOST=0.0.0.0
N8N_PROTOCOL=http
N8N_USER=admin
N8N_PASSWORD=MotDePasseSecurise123!
N8N_ENCRYPTION_KEY=cle32caracteresaleatoires1234567  # CHANGER !

# --- Supabase ---
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Anthropic (Claude AI) ---
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- TradingView ---
# Cookie sessionid de ta session TradingView (F12 → Application → Cookies)
# Nécessaire pour les charts privés ou indicateurs custom
TRADINGVIEW_SESSION_ID=

# --- MetaTrader Bridge ---
MT5_SERVER_PORT=5000   # Port HTTP (n8n → Python)
MT5_BRIDGE_PORT=5001   # Port TCP socket (Python → EA MT5)
