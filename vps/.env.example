# ============================================================
# VPS Hostinger — Variables d'environnement
# Copier en .env et remplir les valeurs
# ============================================================

# --- VPS ---
VPS_IP=123.456.789.0          # IP publique de ton VPS Hostinger

# --- n8n ---
N8N_HOST=0.0.0.0
N8N_PROTOCOL=http
N8N_USER=admin
N8N_PASSWORD=MotDePasseSecurise123!
N8N_ENCRYPTION_KEY=cle32caracteresaleatoires1234567  # CHANGER !

# --- Supabase ---
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Anthropic (Claude AI) ---
ANTHROPIC_API_KEY=sk-ant-api03-...
AI_VISION_MODEL=claude-sonnet-5        # modèle vision (défaut : claude-sonnet-5)

# --- Secret partagé n8n ↔ backend ---
# En-tête X-N8N-Secret des workflows (WF5...). DOIT être identique côté n8n ET backend.
N8N_WEBHOOK_SECRET=change_me_long_random_string

# --- Telegram (rapports pré-open NY) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- TradingView ---
# Cookie sessionid de ta session TradingView (F12 → Application → Cookies)
# Nécessaire pour les charts privés ou indicateurs custom
TRADINGVIEW_SESSION_ID=

# --- MetaTrader Bridge ---
MT5_SERVER_PORT=5000   # Port HTTP (n8n → Python)
MT5_BRIDGE_PORT=5001   # Port TCP socket (Python → EA MT5)

# --- Clé partagée EA MT5 ↔ n8n (workflow n8n_workflow_drevm.json) ---
# Le workflow rejette (401) si body.api_key != $env.DREVM_API_KEY.
# DOIT être STRICTEMENT identique à l'input `InpApiKey` de l'EA mql/DreVM_Bridge.mq5.
# CHANGER en production (valeur forte, identique des deux côtés).
DREVM_API_KEY=drevm-secret-key
