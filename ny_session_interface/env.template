# ==============================================================================
#  ny_session_interface — variables d'environnement (console + pipeline)
#  Copier en `.env` (ou exporter dans le process/service) puis renseigner.
#  ⚠️ Ne jamais committer le vrai `.env` (déjà ignoré par .gitignore).
# ==============================================================================

# ── Console (api.py) ──────────────────────────────────────────────────────────
# Hôte/port du serveur (par défaut localhost:8800). Garder 127.0.0.1 sauf tunnel.
NY_BOT_HOST=127.0.0.1
NY_BOT_PORT=8800

# Protège les routes POST (start/stop, execute…). Vide = pas de protection.
# En prod : chaîne longue et aléatoire, envoyée par n8n via l'en-tête X-Api-Token.
API_TOKEN=

# ── Scoring IA (proxy vers le backend) ────────────────────────────────────────
# URL du backend FastAPI principal qui héberge l'agent de scoring IA.
# C'est CE backend (pas la console) qui a besoin de ANTHROPIC_API_KEY
# (voir backend/env.template).
BACKEND_URL=http://127.0.0.1:8000

# ── Source de prix du validator (/api/signal) ─────────────────────────────────
# Source(s) : "mt5" (défaut), "twelvedata", "alphavantage", OU une CASCADE
# ordonnée séparée par des virgules (ex: twelvedata,alphavantage,mt5) essayée
# jusqu'à obtenir des bougies valides. MT5/sim sert de filet final.
PRICE_SOURCE=mt5
TWELVEDATA_API_KEY=            # requis si PRICE_SOURCE=twelvedata
ALPHAVANTAGE_API_KEY=         # requis si PRICE_SOURCE=alphavantage
PRICE_CACHE_TTL=60            # cache (s) des bougies externes (borne les rate-limits)

# Fenêtre (heures) du filtre news : /api/signal interroge le calendrier backend
# (/api/calendar/upcoming) pour pénaliser les annonces high-impact imminentes.
NEWS_WINDOW_HOURS=2
# Source du calendrier : "backend" (défaut), "mt5" (fichier de CalendarExporter.mq5)
# ou "file" (fichiers JSON ForexFactory hebdomadaires déposés dans CALENDAR_DIR).
NEWS_SOURCE=backend
MT5_CALENDAR_FILE=            # ex: /chemin/vers/MQL5/Files/calendar_export.json
# Dossier des exports FF hebdo (mode "file"). Défaut : <repo>/data/calendar
CALENDAR_DIR=

# ── Exécution d'ordres (/api/execute) — GARDE-FOU ─────────────────────────────
# 0 = exécution DÉSACTIVÉE (défaut, recommandé). 1 = autorise /api/execute.
# Même à 1, aucun ordre réel tant que DRY_RUN est ON dans l'UI.
ALLOW_EXECUTION=0

# ── Telegram (notifications signaux/exécutions) ───────────────────────────────
# Créer un bot via @BotFather, récupérer le token ; chat_id via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Auto-journalisation Supabase (/api/execute → journal_trades) ──────────────
# Laisser vide pour désactiver (le trade s'exécute quand même).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=            # clé service_role (⚠️ secret, jamais côté client)
JOURNAL_USER_ID=                 # auth.users.id du propriétaire du journal (uuid)

# ── Navigation entre dashboards (barre de nav de la console) ──────────────────
# URLs des autres dashboards du projet (défauts localhost).
DASH_CONSOLE_URL=http://localhost:8800
DASH_ANALYTICS_URL=http://localhost:5173
DASH_SAAS_URL=http://localhost:3000

# ── Mode démo ─────────────────────────────────────────────────────────────────
# 1 = injecte parfois des setups en SIMULATION (jamais en MT5 réel). 0 = off.
DEMO_SIGNALS=1

# ── Algo full-auto de prise de position (bot standalone) ──────────────────────
# GARDE-FOU MAÎTRE : 1 = DRY_RUN (aucun ordre réel, défaut). 0 = exécution LIVE.
# À ne passer à 0 QUE sur le VPS Windows, compte connecté, après validation.
DRY_RUN=1
# Profil de risque au démarrage : SCALPING (défaut) | BALANCED | CONSERVATIVE |
# AGGRESSIVE. Pilote risk_pct, min_grade, R:R, max trades/sym, halt drawdown.
BOT_PROFILE=SCALPING

# ── MetaTrader 5 (production, VPS Windows) ────────────────────────────────────
# Par défaut la console se connecte au terminal MT5 DÉJÀ ouvert et loggé
# (mt5.initialize() SANS identifiants) — recommandé. Pour forcer un login
# automatique (ex. démarrage NSSM), renseigner ces 3 variables ICI (dans .env,
# jamais committé). Le code les lit via l'environnement — ne JAMAIS écrire le
# mot de passe en clair dans le code source.
MT5_LOGIN=            # numéro de compte (entier) ; vide = terminal déjà loggé
MT5_PASSWORD=         # ⚠️ secret — uniquement dans .env local, jamais committé
MT5_SERVER=           # ex: FusionMarkets-Live

# ==============================================================================
#  Rappel — variables à définir CÔTÉ n8n (pas ici) pour les workflows :
#    NY_BOT_URL=http://localhost:8800     # cette console
#    NY_BOT_TOKEN=<API_TOKEN ci-dessus>
#    TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID
#  et CÔTÉ backend : ANTHROPIC_API_KEY (cf backend/env.template).
# ==============================================================================
