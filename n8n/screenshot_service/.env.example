# Screenshot Service — run natif (copier en .env)
# Port d'écoute (défaut 3001, doit matcher SCREENSHOT_URL côté n8n)
SCREENSHOT_PORT=3001

# Cookie `sessionid` TradingView (F12 → Application → Cookies → tradingview.com)
# Nécessaire pour les charts privés / indicateurs custom, sinon captures dégradées.
TRADINGVIEW_SESSION_ID=
